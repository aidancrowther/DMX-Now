 // Set up the DMX-Protocol
 void DMXESPSerial::init(int chanQuant) {
+  if (chanQuant > DMX_MAX_CHANNELS || chanQuant <= 0) {
+    chanQuant = DMX_DEFAULT_CHANNELS;
+  }
+
+  chanSize = chanQuant;
+
+  // Local patch: UART0 (Serial) TX-only on GPIO1; GPIO3 (UART0 RX) left free.
+  Serial.begin(DMXSPEED, SERIAL_8N1, SERIAL_TX_ONLY);
   if (chanQuant > dmxMaxChannel || chanQuant <= 0) {
     chanQuant = defaultMax;
   }
@@ -61,9 +89,23 @@ void DMXESPSerial::init(int chanQuant) {
 
   chanSize = chanQuant;
 
+  // Local patch: UART0 (Serial) TX-only on GPIO1; GPIO3 (UART0 RX) left free.
