+//int sendPin = 1;
+
+// DMX value array: layout = [start_code] + channels[1..N]
+// Total size = DMX_START_LEN + DMX_MAX_CHANNELS (513 bytes)
 #define dmxMaxChannel  512
 #define defaultMax 32
 
@@ -38,7 +50,9 @@
 int chanSize;
 
 //DMX value array and size. Entry 0 will hold startbyte
-uint8_t dmxData[dmxMaxChannel] = {};
+uint8_t dmxData[DMX_START_LEN + DMX_MAX_CHANNELS] = {};
 
 void DMXESPSerial::init() {
   chanSize = defaultMax;
