+  // Feature 4: write start byte + all channels (DMX_START_LEN + chanSize)
+  Serial.write(dmxData, DMX_START_LEN + chanSize);
   Serial.flush();
   delay(1);
-  Serial1.end();
+  Serial.end();
 }
 